{
  "schema_version": 2,
  "evidence_mode": "SYNTHETIC_DEMO",
  "languages": ["en", "tw"],
  "dont_know_value": "dont_know",
  "inputs": [
    {"name": "batch_label", "type": "choice", "values": ["Batch 1", "Batch 2", "Batch 3", "Batch 4", "Batch 5", "Batch 6", "Batch 7", "Batch 8", "Batch 9", "Batch 10"], "allows_dont_know": false},
    {"name": "days_drying", "type": "integer", "min": 0, "max": 30, "allows_dont_know": true},
    {"name": "rewetted", "type": "choice", "values": ["yes", "no"], "allows_dont_know": true},
    {"name": "storage_surface", "type": "choice", "values": ["floor", "raised"], "allows_dont_know": true},
    {"name": "musty_smell", "type": "choice", "values": ["yes", "no"], "allows_dont_know": true},
    {"name": "dryness_check", "type": "choice", "values": ["dry", "unsure", "damp"], "allows_dont_know": true},
    {"name": "days_stored", "type": "integer", "min": 0, "max": 180, "allows_dont_know": true},
    {"name": "storage_start", "type": "date", "format": "YYYY-MM-DD", "allows_dont_know": true}
  ],
  "weather_window": {
    "days": 14,
    "start_input": "storage_start",
    "days_input": "days_stored",
    "rule": "check_date is start_input plus days_input days. The window is the 14 days ending on check_date, inclusive, mapped onto the bundled year by day of year and wrapping at the year boundary.",
    "table": "web/weather.json",
    "columns": {"RH2M": "rh2m_mean", "T2M": "t2m_mean"}
  },
  "features": [
    {"name": "days_drying", "source": "input", "input": "days_drying", "encoding": "integer", "reason": "reason_short_drying", "risk": "lower"},
    {"name": "rewetted", "source": "input", "input": "rewetted", "encoding": "map", "map": {"no": 0, "yes": 1}, "reason": "reason_rewetted", "risk": "higher"},
    {"name": "floor", "source": "input", "input": "storage_surface", "encoding": "map", "map": {"raised": 0, "floor": 1}, "reason": "reason_floor", "risk": "higher"},
    {"name": "musty", "source": "input", "input": "musty_smell", "encoding": "map", "map": {"no": 0, "yes": 1}, "reason": "reason_musty", "risk": "higher"},
    {"name": "dryness_check", "source": "input", "input": "dryness_check", "encoding": "map", "map": {"dry": 0, "unsure": 1, "damp": 2}, "reason": "reason_damp_check", "risk": "higher"},
    {"name": "days_stored", "source": "input", "input": "days_stored", "encoding": "integer", "reason": "reason_long_storage", "risk": "higher"},
    {"name": "rh14_mean", "source": "weather", "variable": "RH2M", "aggregate": "mean", "unit": "percent", "reason": "reason_humid_weeks", "risk": "higher"},
    {"name": "rh14_max", "source": "weather", "variable": "RH2M", "aggregate": "max", "unit": "percent", "reason": "reason_humid_weeks", "risk": "higher"},
    {"name": "t14_mean", "source": "weather", "variable": "T2M", "aggregate": "mean", "unit": "degrees C", "reason": null, "risk": null}
  ],
  "classes": ["green", "amber", "red"],
  "bands": [
    {"name": "green", "message": "band_green"},
    {"name": "amber", "message": "band_amber"},
    {"name": "red", "message": "band_red"},
    {"name": "not_sure", "message": "band_not_sure"}
  ],
  "abstention": {
    "band": "not_sure",
    "order": "Check the rules in the order listed. The first rule that holds decides the result and its single reason.",
    "rules": [
      {"id": "dont_know", "when": "any input equals dont_know_value", "reason": "reason_missing_input"},
      {"id": "out_of_range", "when": "any input is not allowed by this contract, or any feature is outside feature_ranges in tree.json (inclusive)", "reason": "reason_out_of_range"},
      {"id": "low_confidence", "when": "the winning class probability at the leaf is below abstain_cut in tree.json", "reason": "reason_low_confidence", "default_abstain_cut": 0.6}
    ]
  },
  "actions": {
    "rule": "If the first reason shown is in reason_action, show that action. Otherwise show the band_default action; null means no action. Green results show no reasons.",
    "reason_action": {
      "reason_rewetted": "action_redry",
      "reason_damp_check": "action_redry",
      "reason_short_drying": "action_redry",
      "reason_floor": "action_raise_bags"
    },
    "band_default": {"green": null, "amber": "action_test_sample", "red": "action_test_sample", "not_sure": "action_test_sample"}
  },
  "recorded_actions": ["redried", "moved_off_floor", "took_sample", "sold", "other"],
  "metrics": ["accuracy", "macro_f1", "red_recall", "false_reassurance_rate", "abstain_rate", "coverage"],
  "message_keys": [
    "band_green", "band_amber", "band_red", "band_not_sure",
    "reason_rewetted", "reason_short_drying", "reason_damp_check", "reason_humid_weeks", "reason_floor", "reason_musty",
    "reason_long_storage", "reason_missing_input", "reason_out_of_range", "reason_low_confidence",
    "action_test_sample", "action_redry", "action_raise_bags",
    "consent_text", "sms_template", "synthetic_label",
    "question_batch_label", "question_days_drying", "question_rewetted", "question_storage_surface",
    "question_musty_smell", "question_dryness_check", "question_days_stored", "question_storage_start",
    "option_yes", "option_no", "option_dont_know", "option_floor", "option_raised", "option_dry", "option_unsure", "option_damp",
    "button_add_batch", "button_check", "button_play", "button_copy_sms", "button_record_action", "button_delete_all", "button_continue",
    "record_redried", "record_moved_off_floor", "record_took_sample", "record_sold", "record_other",
    "title_consent", "title_batches", "title_check", "title_result", "title_settings", "title_evidence",
    "weather_note", "not_evaluated", "language_name", "confirm_delete_all",
    "sms_not_sent", "demo_model_note", "error_storage", "error_model_check", "error_files",
    "evidence_model_version", "evidence_tree_hash", "evidence_file_sizes", "evidence_metrics", "evidence_tree",
    "evidence_baseline", "evidence_sources", "source_weather", "source_labels",
    "metric_accuracy", "metric_macro_f1", "metric_red_recall", "metric_false_reassurance_rate", "metric_abstain_rate", "metric_coverage",
    "button_load_demo", "demo_data_note", "sms_copied",
    "weather_strip", "button_back",
    "error_future_date", "app_tagline", "offline_chip", "summary_line", "app_name"
  ],
  "message_placeholders": {"sms_template": ["batch_label"], "weather_note": ["year"], "source_weather": ["year"], "weather_strip": ["low", "high"], "summary_line": ["count", "total"]}
}
