{
  "description": "The three hand-built demo batches from spec section 7. Inputs use contract.json values; expected features are in contract feature order, computed from weather_table.",
  "weather_table": "weather_sample.json",
  "cases": [
    {
      "id": "clearly_safe",
      "description": "Dried 12 days, never rewetted, stored raised, no musty smell, dry by the hand test, 30 days in store ending in dry weeks.",
      "spec_expectation": "A clearly safe batch for the demo (spec 7).",
      "inputs": {
        "batch_label": "Batch 1",
        "days_drying": 12,
        "rewetted": "no",
        "storage_surface": "raised",
        "musty_smell": "no",
        "dryness_check": "dry",
        "days_stored": 30,
        "storage_start": "2025-07-06"
      },
      "expected": {
        "abstain_reason": null,
        "features": [
          12,
          0,
          0,
          0,
          0,
          30,
          62.40071428571428,
          63.16,
          21.04357142857143
        ],
        "baseline_band": "green"
      }
    },
    {
      "id": "rewetted_dry_weeks",
      "description": "Dried 8 days and rained on during drying, unsure by the hand test, then stored raised for a week in dry weather.",
      "spec_expectation": "The humidity-only baseline calls it green; the tree should not (spec 7).",
      "inputs": {
        "batch_label": "Batch 2",
        "days_drying": 8,
        "rewetted": "yes",
        "storage_surface": "raised",
        "musty_smell": "no",
        "dryness_check": "unsure",
        "days_stored": 7,
        "storage_start": "2025-01-27"
      },
      "expected": {
        "abstain_reason": null,
        "features": [
          8,
          1,
          0,
          0,
          1,
          7,
          62.44642857142857,
          63.25,
          18.939999999999998
        ],
        "baseline_band": "green"
      }
    },
    {
      "id": "missing_input",
      "description": "Stored on the floor for 30 days; the farmer did not do the hand test and answered \"Don't know\".",
      "spec_expectation": "Returns not_sure with reason_missing_input (spec 5.3, rule 1).",
      "inputs": {
        "batch_label": "Batch 3",
        "days_drying": 10,
        "rewetted": "no",
        "storage_surface": "floor",
        "musty_smell": "no",
        "dryness_check": "dont_know",
        "days_stored": 30,
        "storage_start": "2025-04-01"
      },
      "expected": {
        "abstain_reason": "reason_missing_input",
        "features": null,
        "baseline_band": null
      }
    }
  ]
}
