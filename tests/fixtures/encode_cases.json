        "batch_label": "Batch 1",
        "days_drying": 12.0,
        "rewetted": "no",
        "storage_surface": "raised",
        "musty_smell": "no",
        "dryness_check": "dry",
        "days_stored": 30,
        "storage_start": "2025-07-06"
      },
      "expected": {
        "abstain_reason": null,
        "features": [
          12,
          0,
          0,
          0,
          0,
          30,
          62.40071428571428,
          63.16,
          21.04357142857143
